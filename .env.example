# --- CSM : variables d'environnement (lues au démarrage, pas au build) ---

# URL publique de l'application (obligatoire en production, protection CSRF des formulaires)
ORIGIN=https://csm.fs0ciety.org

# Supabase (Dashboard > Settings > API)
PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# Clé service_role : SERVEUR UNIQUEMENT (création d'utilisateurs, sauvegarde). Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Connexion Postgres directe (sauvegarde admin) — optionnelle
DATABASE_URL=

# Taille max des envois (documents)
BODY_SIZE_LIMIT=25M
